#--------------------------------------------------------------------
# Dùng khi chạy KHÔNG qua Docker: copy file này thành ".env"
# (Khi chạy bằng Docker, các giá trị này đã nằm trong compose.yaml)
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Ho_Chi_Minh'

database.default.hostname = 127.0.0.1
database.default.database = ql_banhang
database.default.username = appuser
database.default.password = apppassword
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

session.expiration = 1800
security.regenerate = false

# true = chỉ khách đã mua sản phẩm mới được đánh giá
nova.reviewRequirePurchase = false
